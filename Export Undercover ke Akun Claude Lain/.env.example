# ==========================================================
# Undercover - Market Intelligence (Shopee)
# Salin file ini ke `.env` lalu sesuaikan. JANGAN commit .env.
# ==========================================================

# --- Database ---
DB_PATH=data/undercover.db

# --- Discovery / Monitoring ---
# Keyword bisa ditaruh di file (satu per baris) ATAU langsung comma-separated.
# Jika KEYWORDS_FILE ada isinya, itu yang dipakai.
KEYWORDS_FILE=keywords.txt
KEYWORDS=cover mobil,body cover mobil,cover mobil avanza
MAX_PRODUCTS_PER_KEYWORD=200

# --- Scraping (Playwright) ---
SHOPEE_BASE_URL=https://shopee.co.id
HEADLESS=true
# Jeda acak antar request (detik) biar tidak terlihat seperti bot
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0
PAGE_TIMEOUT_MS=30000
# Retry saat fetch gagal
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0

# Proxy (opsional, sangat disarankan untuk Shopee). Kosongkan jika tidak pakai.
# Format: http://user:pass@host:port
PROXY_URL=

# User-Agent override (opsional). Kosongkan = pakai default (Chrome di macOS).
USER_AGENT=

# Sesi login Shopee (WAJIB). Dihasilkan oleh `python main.py login`.
# Shopee menolak hasil pencarian untuk sesi yang belum login.
SHOPEE_STORAGE_STATE=storage_state.json

# --- Compare ---
MY_PRODUCTS_CSV=my_products.csv
PRICE_GAP_ALERT_THRESHOLD=20000
FUZZY_MATCH_THRESHOLD=80

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/undercover.log
